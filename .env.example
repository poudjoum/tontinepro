# ═══════════════════════════════════════════════════════════════════
#  TontinePro — Variables d'environnement de production
#  Copiez ce fichier en .env et remplissez chaque valeur.
#  IMPORTANT : .env est dans .gitignore, ne le committez jamais.
# ═══════════════════════════════════════════════════════════════════

# ── PostgreSQL ───────────────────────────────────────────────────────
POSTGRES_DB=tontinepro_db
POSTGRES_USER=tontinepro_user
POSTGRES_PASSWORD=CHANGEME_strong_password_here

# ── Redis (laisser vide pour désactiver le mot de passe) ─────────────
REDIS_PASSWORD=

# ── JWT ──────────────────────────────────────────────────────────────
# Générer avec : openssl rand -base64 64
JWT_SECRET=CHANGEME_at_least_64_chars_random_secret
JWT_ACCESS_EXP_MS=900000
JWT_REFRESH_EXP_MS=604800000

# ── Email (Gmail App Password) ────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=poudjoumrodrigue@gmail.com
MAIL_PASSWORD=CHANGEME_gmail_app_password
MAIL_FROM=poudjoumrodrigue@gmail.com

# ── Serveur ───────────────────────────────────────────────────────────
SERVER_HOST=192.168.1.209
